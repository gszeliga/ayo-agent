                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`X-API-Key` is missing or wrong."
          },
          "413": {
            "content": {
              "application/json": {
                "examples": {
                  "file_too_large": {
                    "summary": "File too large",
                    "value": {
                      "detail": [
                        {
                          "loc": [
                            "body",
                            "file"
                          ],
                          "msg": "file exceeds 5242880 bytes",
                          "type": "file_too_large"
                        }
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The file is larger than `MAX_UPLOAD_BYTES`."
          },
          "422": {
            "content": {
              "application/json": {
                "examples": {
                  "file_encoding": {
                    "summary": "Not UTF-8",
                    "value": {
                      "detail": [
                        {
                          "loc": [
                            "body",
                            "file"
                          ],
                          "msg": "file is not valid UTF-8",
                          "type": "file_encoding"
                        }
                      ]
                    }
                  },
                  "file_extension": {
                    "summary": "Not a .md file",
                    "value": {
                      "detail": [
                        {
                          "loc": [
                            "body",
                            "file"
                          ],
                          "msg": "file must have a .md extension",
                          "type": "file_extension"
                        }
                      ]
                    }
                  },
                  "file_no_content": {
                    "summary": "Nothing to index",
                    "value": {
                      "detail": [
                        {
                          "loc": [
                            "body",
