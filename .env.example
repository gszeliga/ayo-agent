# Copy to .env and fill in. Never commit .env.
# It is read from the project root whatever the working directory; to use another file,
# set AYO_ENV_FILE=/path/to/file in the environment (not in this file). Empty values
# (KEY=) count as unset: a required one makes startup fail.

# Database. Never point any of these at production.
#
# Setup A, local Docker database (scripts/dev_db.sh up):
DATABASE_URL=postgresql://ayo:ayo@localhost:5433/ayo
#
# Setup B, a Neon *dev* branch (comment out setup A):
# DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# MIGRATIONS_DATABASE_URL=postgresql://<role>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
# ALLOW_REMOTE_DATABASE=true
#
# MIGRATIONS_DATABASE_URL is optional (Alembic falls back to DATABASE_URL). With Neon use the
# direct endpoint for it, without "-pooler". A host other than localhost is refused unless
# ALLOW_REMOTE_DATABASE=true. Environment variables win over this file, so with setup B in
# .env you can still use the local database for one command:
#   DATABASE_URL=postgresql://ayo:ayo@localhost:5433/ayo ALLOW_REMOTE_DATABASE=false uv run ...
# psycopg log level: INFO shows pool events, DEBUG also connection attempts (host/port only).
DB_LOG_LEVEL=WARNING

# Provisional admin API key, sent as the X-API-Key header.
ADMIN_API_KEY=change-me

MAX_UPLOAD_BYTES=5242880
DOCS_ENABLED=true
# Browser origins allowed to call the API (comma-separated, http(s)://host[:port], no
# trailing slash, no *). Empty = CORS off.
CORS_ALLOWED_ORIGINS=

# Chunk sizes are in characters.
CHUNK_SIZE=800
CHUNK_OVERLAP=80
MIN_CHUNK_SIZE=100

# voyage | fake (fake = deterministic vectors, no network)
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=pa-your-key-here
VOYAGE_BASE_URL=https://api.voyageai.com/v1
EMBEDDING_BATCH_SIZE=128
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

# Language model, through OpenRouter (https://openrouter.ai/settings/keys). Not used by any
# endpoint yet; the app starts without a key, which is only needed when a model is called.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BUDGET_SECONDS=90
# deny = only upstream providers that neither store nor train on prompts (customer content).
LLM_DATA_COLLECTION=deny
# true = only Zero Data Retention endpoints (stricter; fewer providers per model).
LLM_ZDR=false
# none | minimal | low | medium | high | xhigh | max; unset = the model's default.
LLM_REASONING_EFFORT=
# Optional attribution headers sent to OpenRouter (HTTP-Referer, X-OpenRouter-Title).
LLM_APP_URL=
LLM_APP_TITLE=
